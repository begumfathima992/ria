NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hh_cosmetics
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-value
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-different-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

RESET_TOKEN_TTL_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

FREE_DELIVERY_THRESHOLD=45
STANDARD_DELIVERY_FEE=4.95
EXPRESS_DELIVERY_FEE=7.95
COD_FEE=0
DEFAULT_CURRENCY=GBP
